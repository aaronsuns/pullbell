{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pullbell",
  "version": "0.1.0",
  "identifier": "se.zexa.pullbell",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A menu bar GitHub inbox",
    "copyright": "© 2026 Aaron Sun. MIT licence.",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNERjExOTIzMTU4QUE2ODYKUldTR3Bvb1ZJeG54UFhlbWYrbFRod2orWnpXSVpMMnIxdUorZElnakUzNWVJYm52YTV3azlPVkgK",
      "endpoints": [
        "https://github.com/aaronsuns/pullbell/releases/latest/download/latest.json"
      ]
    }
  }
}
